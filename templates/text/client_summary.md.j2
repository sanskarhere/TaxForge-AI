- SSN: N/A
- DOB: N/A
- Occupation: N/A
- Employer: N/A
{% endif %}

## Address
- Street: {{ case.address.street }}
- City: {{ case.address.city }}
- State: {{ case.address.state }}
- ZIP: {{ case.address.zip_code }}
- County: {{ case.address.county }}

## Dependents
{% if case.dependents %}
{% for d in case.dependents %}
- {{ d.first_name }} {{ d.last_name }} ({{ d.relationship }}) — SSN: {{ d.ssn }}
{% endfor %}
{% else %}
